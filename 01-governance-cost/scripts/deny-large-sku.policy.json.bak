{
  "if": {
    "allOf": [
      { "field": "type", "equals": "Microsoft.Compute/virtualMachines" },
      { "field": "Microsoft.Compute/virtualMachines/sku.name", "notIn": [ "Standard_B1s", "Standard_B2s", "Standard_D2s_v5", "Standard_A1_v2", "Standard_A2_v2", "Standard_D2_v2" ] }
    ]
  },
  "then": { "effect": "deny" }
}